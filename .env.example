# clefline settings. Every one is optional; the defaults suit one person running
# this on their own machine. Copy to .env or export in the service environment.
# There are no secrets here.

# Where the server listens. Keep it on loopback: there is no authentication.
CLEFLINE_HOST=127.0.0.1
CLEFLINE_PORT=8104

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
CLEFLINE_LOG_LEVEL=INFO

# Audio, stems, jobs and logs. Empty means data/ inside the repo.
CLEFLINE_DATA_DIR=

# Longest recording to transcribe, in seconds (default 900 = 15 minutes).
CLEFLINE_MAX_DURATION_SECONDS=900

# Refuse to start a download or separation below this much free disk (whole GB).
CLEFLINE_MIN_FREE_GB=3

# Extra Host headers to accept, comma separated (127.0.0.1 and localhost always are).
CLEFLINE_ALLOWED_HOSTS=
